# Copy to .env and fill in. .env is gitignored.
DOCFACTORY_PROVIDER=ollama
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=replace-with-your-ollama-cloud-key
DOCFACTORY_MODEL=gemma4:31b
# Context window sent to Ollama (default 16384): enough for extraction (one tool schema of at most ~1.5k tokens plus a 3500-character batch).
DOCFACTORY_NUM_CTX=16384
# Only for the first Phase 4 build (search index + generator agent), which the Phase 4 rework removes together with these settings.
# Embedding model for its index (Ollama /api/embed; must be an embedding model on your host).
DOCFACTORY_EMBED_MODEL=nomic-embed-text
# Ollama Cloud serves no embedding models: point the embedder at a local server that has one (ollama pull nomic-embed-text).
# The chat OLLAMA_API_KEY is not sent there; set DOCFACTORY_EMBED_API_KEY only if that server needs a key.
# DOCFACTORY_EMBED_HOST=http://localhost:11434
