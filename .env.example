# Copy to .env and fill in. .env is gitignored.
DOCFACTORY_PROVIDER=ollama
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=replace-with-your-ollama-cloud-key
DOCFACTORY_MODEL=gemma4:31b
# Context window sent to Ollama (default 16384). The extraction agent needs more: its tool schemas alone are ~18k tokens.
DOCFACTORY_NUM_CTX=65536
# Embedding model for the Phase 4 frontmatter index (Ollama /api/embed; must be an embedding model on your host).
DOCFACTORY_EMBED_MODEL=nomic-embed-text
