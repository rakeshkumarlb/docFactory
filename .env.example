# Copy to .env and fill in. .env is gitignored.
DOCFACTORY_PROVIDER=ollama
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=replace-with-your-ollama-cloud-key
DOCFACTORY_MODEL=gemma4:31b
# Context window sent to Ollama (default 16384): enough for extraction (one tool schema of at most ~1.5k tokens plus a 3500-character batch).
DOCFACTORY_NUM_CTX=16384
